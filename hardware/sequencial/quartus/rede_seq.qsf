# =============================================================================
# Projeto Quartus II 13.0 SP1 - Arquitetura SEQUENCIAL (Pessoa 2)
# Placa: Terasic DE1 - FPGA Cyclone II EP2C20F484C7
# Caminhos relativos a esta pasta (hardware/sequencial/quartus/)
# =============================================================================

# ---- Dispositivo ------------------------------------------------------------
set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C20F484C7
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

# ---- Topo -------------------------------------------------------------------
# Etapa atual: topo temporario que mede o MAC sozinho.
# Quando o top_seq.v existir, trocar para: top_seq
set_global_assignment -name TOP_LEVEL_ENTITY top_mac_sintese

# ---- Arquivos de projeto ----------------------------------------------------
# Modulos compartilhados com a arquitetura paralela
set_global_assignment -name VERILOG_FILE ../../comum/mac.v
# Modulos da arquitetura sequencial
set_global_assignment -name VERILOG_FILE ../top_mac_sintese.v
# Restricoes de tempo
set_global_assignment -name SDC_FILE rede_seq.sdc

# ---- Simulacao (ModelSim-Altera via NativeLink) ----------------------------
# O testbench NAO e arquivo de projeto: entra so aqui, na configuracao do NativeLink.
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_ENABLE_STATUS TEST_BENCH_MODE -section_id eda_simulation
set_global_assignment -name EDA_NATIVELINK_SIMULATION_TEST_BENCH tb_mac -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_NAME tb_mac -section_id eda_simulation
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME uut -section_id tb_mac
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_mac -section_id tb_mac
set_global_assignment -name EDA_TEST_BENCH_FILE ../../../testes/tb_mac.v -section_id tb_mac

# ---- Pinos ------------------------------------------------------------------
# Nesta etapa os pinos ficam sem atribuicao (o Quartus escolhe sozinho):
# o objetivo e so medir recursos e Fmax do MAC. Quando o topo virar top_seq,
# usar CLOCK_50 = PIN_L1 e o restante do DE1_pin_assignments.csv da Terasic.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"

set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top